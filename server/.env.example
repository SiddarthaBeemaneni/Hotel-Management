# =========================================================
# SIDDARTHA PALACE — Server Environment Variables
# Copy this file to .env and fill in your values
# =========================================================

# Server
PORT=3000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=siddartha_palace

# Twilio (SMS + WhatsApp)
# Leave blank to run in dry-run mode (messages logged to console)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# Reminder Settings
REMINDER_CRON=0 9 * * *
REMINDER_START_DAY=1
REMINDER_END_DAY=5
